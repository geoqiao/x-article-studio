{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Article Studio X companion",
  "version": "0.1.2",
  "description": "Turn Markdown, images, tables, and Mermaid diagrams from Article Studio into X Article drafts, with a review before uploading.",
  "homepage_url": "https://md2xarticle.com/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://x.com/compose/articles*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "review.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4318/*",
        "http://127.0.0.1:4318/*"
      ],
      "js": ["app-content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open Article Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
