{
  "name": "@opc/x-article-studio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "check": "tsc --noEmit && tsc --noEmit -p extension/tsconfig.json",
    "test": "vitest run",
    "build:extension": "node scripts/build-extension.mjs",
    "build:store": "ARTICLE_STUDIO_ORIGIN=https://md2xarticle.com node scripts/build-extension.mjs --store",
    "build:html": "node scripts/build-html-preview.mjs",
    "build": "pnpm check && pnpm build:extension && vite build",
    "build:production": "ARTICLE_STUDIO_ORIGIN=https://md2xarticle.com pnpm build",
    "deploy": "wrangler deploy",
    "deploy:www": "wrangler deploy --config wrangler.www.jsonc",
    "preview": "vite preview --host 127.0.0.1 --port 4318 --strictPort"
  },
  "dependencies": {
    "@kaitox/x-article": "0.6.0",
    "dompurify": "^3.3.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "marked": "18.0.5",
    "mermaid": "11.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "4.131.2"
  },
  "packageManager": "pnpm@11.5.0"
}
